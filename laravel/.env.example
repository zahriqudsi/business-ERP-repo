APP_NAME="SJ Technology"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sjpos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sj.sjtechnology.lk"
MAIL_FROM_NAME="SJ Technology Invoice System"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Colombo

# Mailgun (set MAIL_MAILER=mailgun to send real email)
MAILGUN_DOMAIN=sj.sjtechnology.lk
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Login OTP (email verification code). Keep false until Mailgun sending works.
OTP_ENABLED=false
OTP_EMAIL=sjtechnology365@gmail.com

# Multi-tenancy (each business gets its own database). Off = one business on DB_DATABASE.
TENANCY_ENABLED=false
TENANCY_BASE_DOMAIN=localhost
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1
TENANCY_ADMIN_DOMAIN=admin.localhost
TENANCY_DATABASE_PREFIX=tenant_

# Platform database (businesses, domains, plans). Its user also needs CREATE DATABASE.
LANDLORD_DB_DATABASE=sjpos_landlord
LANDLORD_DB_USERNAME=
LANDLORD_DB_PASSWORD=
